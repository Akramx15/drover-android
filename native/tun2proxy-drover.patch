+#[cfg(test)]
+mod drover_tests {
+    use super::*;
+    use std::{
+        io,
+        pin::Pin,
+        task::{Context, Poll},
+    };
+
+    #[derive(Default)]
+    struct RecordingWriter {
+        attempts: Vec<Vec<u8>>,
+        fail_calls: Vec<usize>,
+    }
+
+    impl AsyncWrite for RecordingWriter {
+        fn poll_write(mut self: Pin<&mut Self>, _cx: &mut Context<'_>, buf: &[u8]) -> Poll<io::Result<usize>> {
+            let call = self.attempts.len();
+            self.attempts.push(buf.to_vec());
+            if self.fail_calls.contains(&call) {
+                Poll::Ready(Err(io::Error::other("injected failure")))
+            } else {
+                Poll::Ready(Ok(buf.len()))
+            }
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_shutdown(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    #[tokio::test]
+    async fn completed_session_task_is_reaped_without_polling_an_empty_set() {
+        let mut session_tasks = tokio::task::JoinSet::new();
+        session_tasks.spawn(async {});
+
+        let completed = tokio::select! {
+            completed = session_tasks.join_next(), if !session_tasks.is_empty() => completed,
+            else => panic!("a non-empty session task set must be polled"),
+        };
+
+        assert!(matches!(completed, Some(Ok(()))));
+        assert!(session_tasks.is_empty());
+
+        enum Branch {
+            EmptySet,
+            Timer,
+        }
+        let branch = tokio::select! {
+            _ = session_tasks.join_next(), if !session_tasks.is_empty() => Branch::EmptySet,
+            _ = tokio::time::sleep(Duration::from_millis(1)) => Branch::Timer,
+        };
+        assert!(matches!(branch, Branch::Timer));
+    }
+
+    #[tokio::test]
+    async fn drover_writes_two_datagrams_then_original_after_delay() {
+        let payload = [0xa5; 74];
+        let mut writer = RecordingWriter::default();
+        let started = Instant::now();
+
+        write_direct_udp_packet(&mut writer, &payload, true).await.unwrap();
+
+        assert!(started.elapsed() >= Duration::from_millis(45));
+        assert_eq!(writer.attempts, vec![vec![0], vec![1], payload.to_vec()]);
+    }
+
+    #[tokio::test]
+    async fn drover_does_not_modify_nonmatching_send() {
+        let payload = [0x5a; 73];
+        let mut writer = RecordingWriter::default();
+
+        write_direct_udp_packet(&mut writer, &payload, false).await.unwrap();
+
+        assert_eq!(writer.attempts, vec![payload.to_vec()]);
+    }
+
+    #[tokio::test]
+    async fn drover_still_attempts_original_when_preamble_fails() {
+        let payload = [0xc3; 74];
+        let mut writer = RecordingWriter {
+            fail_calls: vec![0, 1],
+            ..RecordingWriter::default()
+        };
+
+        write_direct_udp_packet(&mut writer, &payload, true).await.unwrap();
+
+        assert_eq!(writer.attempts, vec![vec![0], vec![1], payload.to_vec()]);
+    }
+
+    #[test]
+    fn observe_strategy_never_applies_discord_preamble() {
+        assert!(!should_apply_drover_preamble(DroverStrategy::None, ProxyType::None, 3478, true, 74,));
+    }
+
+    #[test]
+    fn observe_strategy_preserves_private_dns_destination() {
+        let destination: SocketAddr = "192.168.1.1:53".parse().unwrap();
+        assert!(!should_rewrite_dns_destination(DroverStrategy::None, destination));
+    }
+
+    #[test]
+    fn discord_strategy_rewrites_private_dns_destination() {
+        let destination: SocketAddr = "192.168.1.1:53".parse().unwrap();
+        assert!(should_rewrite_dns_destination(DroverStrategy::Discord, destination));
+    }
+
+    #[test]
+    fn discord_strategy_preserves_public_dns_destination() {
+        let destination: SocketAddr = "8.8.8.8:53".parse().unwrap();
+        assert!(!should_rewrite_dns_destination(DroverStrategy::Discord, destination));
+    }
+
+    #[test]
+    fn discord_strategy_stays_narrow() {
+        assert!(should_apply_drover_preamble(
+            DroverStrategy::Discord,
+            ProxyType::None,
+            50000,
+            true,
+            74,
+        ));
+        assert!(!should_apply_drover_preamble(
+            DroverStrategy::Discord,
+            ProxyType::None,
+            DNS_PORT,
+            true,
+            74,
+        ));
+        assert!(!should_apply_drover_preamble(
+            DroverStrategy::Discord,
+            ProxyType::None,
+            50000,
+            false,
+            74,
+        ));
+    }
+
+    #[tokio::test]
+    async fn udp_source_is_claimed_once_until_idle_timeout() {
+        let source: SocketAddr = "10.77.0.1:40000".parse().unwrap();
+        let tracker = DroverUdpTracker::new(Duration::from_millis(20));
+
+        assert!(tracker.claim(source).await);
+        assert!(!tracker.claim(source).await);
+
+        // Make the entry deterministically stale instead of relying on a
+        // timing-sensitive sleep in the test.
+        tracker
+            .sources
+            .lock()
+            .await
+            .insert(source, Instant::now() - Duration::from_millis(21));
+        assert!(tracker.claim(source).await);
+    }
+
+    #[tokio::test]
+    async fn udp_source_refresh_skips_shared_write_until_due() {
+        let source: SocketAddr = "10.77.0.1:40001".parse().unwrap();
+        let tracker = DroverUdpTracker::new(Duration::from_secs(120));
+        assert!(tracker.claim(source).await);
+        let first_seen = *tracker.sources.lock().await.get(&source).unwrap();
+
+        let mut next_refresh = Instant::now() + Duration::from_secs(30);
+        assert!(!tracker.touch_if_due(source, &mut next_refresh).await);
+        assert_eq!(*tracker.sources.lock().await.get(&source).unwrap(), first_seen);
+
+        next_refresh = Instant::now();
+        assert!(tracker.touch_if_due(source, &mut next_refresh).await);
+        assert!(*tracker.sources.lock().await.get(&source).unwrap() >= first_seen);
+        assert!(next_refresh > Instant::now());
+    }
+}
