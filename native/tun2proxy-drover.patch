diff --git a/src/lab_trace.rs b/src/lab_trace.rs
new file mode 100644
index 0000000000000000000000000000000000000000..01e85f8181ec045a213b189b918e6233e5795467
--- /dev/null
+++ b/src/lab_trace.rs
@@ -0,0 +1,139 @@
+use crate::{args::DroverStrategy, session_info::SessionInfo};
+use std::{
+    fs::{File, create_dir_all},
+    io::{BufWriter, Write},
+    path::Path,
+    sync::{
+        Mutex,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::Instant,
+};
+
+const MAX_TRACE_BYTES: usize = 1024 * 1024;
+const FLUSH_EVERY_LINES: usize = 16;
+pub(crate) const MAX_PACKET_EVENTS_PER_DIRECTION: usize = 32;
+
+struct TraceWriter {
+    file: BufWriter<File>,
+    bytes_written: usize,
+    pending_lines: usize,
+}
+
+/// A bounded diagnostic trace for the Drover lab builds.
+///
+/// It intentionally records only timing, transport metadata, endpoints, and
+/// packet lengths. Packet payloads and DNS question names never enter this
+/// writer. Keeping the format as JSON Lines makes a partial trace useful even
+/// if the extension or Android service is stopped abruptly.
+pub(crate) struct LabTrace {
+    started: Instant,
+    next_session_id: AtomicU64,
+    writer: Mutex<TraceWriter>,
+}
+
+impl LabTrace {
+    pub(crate) fn create(path: &Path, strategy: DroverStrategy) -> std::io::Result<Self> {
+        if let Some(parent) = path.parent() {
+            create_dir_all(parent)?;
+        }
+        let file = File::create(path)?;
+        let trace = Self {
+            started: Instant::now(),
+            next_session_id: AtomicU64::new(1),
+            writer: Mutex::new(TraceWriter {
+                file: BufWriter::new(file),
+                bytes_written: 0,
+                pending_lines: 0,
+            }),
+        };
+        trace.write_line(format!(
+            "{{\"schema\":1,\"event\":\"start\",\"t_ms\":0,\"strategy\":\"{strategy}\",\"payload_captured\":false}}"
+        ));
+        Ok(trace)
+    }
+
+    pub(crate) fn begin_session(&self, session: SessionInfo) -> u64 {
+        let id = self.next_session_id.fetch_add(1, Ordering::Relaxed);
+        let family = if session.dst.is_ipv4() { 4 } else { 6 };
+        let protocol = session.protocol.to_string().to_ascii_lowercase();
+        self.write_line(format!(
+            "{{\"schema\":1,\"event\":\"session\",\"t_ms\":{},\"id\":{id},\"protocol\":\"{protocol}\",\"ip_version\":{family},\"destination\":\"{}\",\"port\":{}}}",
+            self.elapsed_ms(),
+            session.dst.ip(),
+            session.dst.port(),
+        ));
+        id
+    }
+
+    pub(crate) fn packet(&self, session_id: u64, direction: &'static str, index: usize, length: usize, modified: bool) {
+        if index >= MAX_PACKET_EVENTS_PER_DIRECTION {
+            return;
+        }
+        self.write_line(format!(
+            "{{\"schema\":1,\"event\":\"packet\",\"t_ms\":{},\"id\":{session_id},\"direction\":\"{direction}\",\"index\":{},\"length\":{length},\"modified\":{modified}}}",
+            self.elapsed_ms(),
+            index + 1,
+        ));
+    }
+
+    fn elapsed_ms(&self) -> u128 {
+        self.started.elapsed().as_millis()
+    }
+
+    fn write_line(&self, line: String) {
+        let Ok(mut writer) = self.writer.lock() else {
+            return;
+        };
+        let required = line.len().saturating_add(1);
+        if writer.bytes_written.saturating_add(required) > MAX_TRACE_BYTES {
+            return;
+        }
+        if writeln!(writer.file, "{line}").is_err() {
+            return;
+        }
+        writer.bytes_written += required;
+        writer.pending_lines += 1;
+        if writer.pending_lines >= FLUSH_EVERY_LINES && writer.file.flush().is_ok() {
+            writer.pending_lines = 0;
+        }
+    }
+}
+
+impl Drop for LabTrace {
+    fn drop(&mut self) {
+        // Clean VPN shutdowns flush the final partial batch. Batching avoids a
+        // synchronous filesystem flush for every early call packet, which
+        // would otherwise perturb the timing this lab is trying to observe.
+        if let Ok(writer) = self.writer.get_mut() {
+            let _ = writer.file.flush();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session_info::IpProtocol;
+    use std::{fs, net::SocketAddr};
+
+    #[test]
+    fn trace_contains_metadata_but_never_payload() {
+        let path = std::env::temp_dir().join(format!("drover-lab-trace-{}.jsonl", std::process::id()));
+        let trace = LabTrace::create(&path, DroverStrategy::None).unwrap();
+        let session = SessionInfo::new(
+            "10.77.0.1:40000".parse::<SocketAddr>().unwrap(),
+            "203.0.113.7:3478".parse::<SocketAddr>().unwrap(),
+            IpProtocol::Udp,
+        );
+        let id = trace.begin_session(session);
+        trace.packet(id, "up", 0, 123, false);
+        drop(trace);
+
+        let contents = fs::read_to_string(&path).unwrap();
+        let _ = fs::remove_file(path);
+        assert!(contents.contains("\"destination\":\"203.0.113.7\""));
+        assert!(contents.contains("\"length\":123"));
+        assert!(contents.contains("\"payload_captured\":false"));
+    }
+}
