+/// Tracks the first send made by a virtual UDP source socket. `ipstack`
+/// creates one session per destination, while discord-drover tracks the
+/// underlying Discord socket, which may contact several destinations.
+struct DroverUdpTracker {
+    sources: Mutex<HashMap<SocketAddr, Instant>>,
+    timeout: Duration,
+    refresh_interval: Duration,
+}
+
+impl DroverUdpTracker {
+    fn new(timeout: Duration) -> Self {
+        // Refresh at most every 30 seconds (and four times inside shorter
+        // expiry windows). The hot datagram path only checks an Instant; it
+        // does not lock or write the shared map for every packet.
+        let refresh_interval = std::cmp::max(Duration::from_millis(1), std::cmp::min(timeout / 4, Duration::from_secs(30)));
+        Self {
+            sources: Mutex::new(HashMap::new()),
+            timeout,
+            refresh_interval,
+        }
+    }
+
+    async fn claim(&self, source: SocketAddr) -> bool {
+        let now = Instant::now();
+        let mut sources = self.sources.lock().await;
+        sources.retain(|_, last_seen| now.duration_since(*last_seen) <= self.timeout);
+        sources.insert(source, now).is_none()
+    }
+
+    fn next_refresh_deadline(&self) -> Instant {
+        Instant::now() + self.refresh_interval
+    }
+
+    async fn touch_if_due(&self, source: SocketAddr, next_refresh: &mut Instant) -> bool {
+        let now = Instant::now();
+        if now < *next_refresh {
+            return false;
+        }
+        self.sources.lock().await.insert(source, now);
+        *next_refresh = now + self.refresh_interval;
+        true
+    }
+}
